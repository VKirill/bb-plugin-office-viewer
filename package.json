{
  "name": "bb-plugin-office-viewer",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.87"
  },
  "bb": {
    "name": "Office Viewer",
    "description": "View Excel, OpenDocument and CSV spreadsheets in BB: sheets, frozen header, merged cells, search.",
    "branding": {
      "icon": "GridView"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.87",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "description": "Office Viewer for BB: read-only viewer for .xlsx, .xls, .ods and .csv spreadsheets.",
  "keywords": [
    "bb",
    "bb-plugin",
    "excel",
    "xlsx",
    "csv",
    "spreadsheet",
    "viewer",
    "file-opener"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test locate.test.ts sheet.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build ."
  },
  "license": "MIT",
  "author": "Kirill Vechkasov (https://github.com/VKirill)"
}
